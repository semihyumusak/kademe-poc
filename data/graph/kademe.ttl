<https://w3id.org/kademe/id/kanun/2547/m36/surum/2010-07-16> a kademe:Surum ;
    kademe:baslangicKaynagi "not" ;
    kademe:durum "yururlukte" ;
    kademe:surumu <https://w3id.org/kademe/id/kanun/2547/m36> ;
