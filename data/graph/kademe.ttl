<https://w3id.org/kademe/id/kanun/2547/m52/surum/1983-08-19> a kademe:Surum ;
    kademe:baslangicKaynagi "tablo" ;
    kademe:durum "yururlukte" ;
    kademe:surumu <https://w3id.org/kademe/id/kanun/2547/m52> ;
