<https://w3id.org/kademe/id/kanun/2547/m1/surum/1981-11-06> a kademe:Surum ;
    kademe:baslangicKaynagi "dogum" ;
    kademe:durum "yururlukte" ;
    kademe:metin "Madde 1 – Bu kanunun amacı; yükseköğretimle ilgili amaç ve ilkeleri belirlemek ve bütün yükseköğretim kurumlarının ve üst kuruluşlarının teşkilatlanma, işleyiş, görev, yetki ve sorumlulukları ile eğitim - öğretim, araştırma, yayım, öğretim elemanları, öğrenciler ve diğer personel ile ilgili esasları bir bütünlük içinde düzenlemektir."@tr ;
    kademe:surumu <https://w3id.org/kademe/id/kanun/2547/m1> ;
    kademe:yururlukBaslangic "1981-11-06"^^xsd:date .

