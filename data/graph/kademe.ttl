    kademe:durum "yururlukte" ;
    kademe:metin "Geçici Madde 20 – Öğretim üyelerinin emeklilik yaş haddi 1982 yılı için 70, 1983 yılı için 69, 1984 yılı için 68 yaşını doldurdukları tarihtir."@tr ;
    kademe:surumu <https://w3id.org/kademe/id/kanun/2547/gm20> ;
