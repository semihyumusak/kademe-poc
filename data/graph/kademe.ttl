    kademe:durum "yururlukte" ;
    kademe:metin "Geçici Madde 25 – Orta Doğu Teknik Üniversitesinde, 1981 mali yılı bütçe uygulamasına bu kanun gereklerine göre 1982 mali yılı başına kadar devam edilir."@tr ;
    kademe:surumu <https://w3id.org/kademe/id/kanun/2547/gm25> ;
