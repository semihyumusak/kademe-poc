    kademe:baslangicKaynagi "dogum" ;
    kademe:durum "yururlukte" ;
    kademe:metin "MADDE 10 – (1) Senatonun 30.05.2017 tarih ve S-2017-11/01sayılı kararıyla kabul edilen bu yönerge, 2017-2018 eğitim-öğretim yılı başında yürürlüğe girer."@tr ;
