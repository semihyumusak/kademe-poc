    kademe:durum "yururlukte" ;
    kademe:metin "MADDE 16- (1) Üniversiteye dikey geçiş veya yatay geçiş yoluyla kayıt yaptıran öğrencilerin mezuniyet için üç ortak eğitim dönemini tamamlamış olması gerekir."@tr ;
    kademe:surumu <https://w3id.org/kademe/id/yonerge/etu-ortak-egitim/m16> ;
    kademe:yururlukBaslangic "2016-02-11"^^xsd:date .

