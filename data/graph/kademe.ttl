<https://w3id.org/kademe/id/yonetmelik/15287/m2/surum/2011-09-01> a kademe:Surum ;
    kademe:baslangicKaynagi "dogum" ;
    kademe:durum "yururlukte" ;
    kademe:metin "MADDE 2 – (1) Bu Yönetmelik, 2547 sayılı Yükseköğretim Kanununun 44 üncü maddesine dayanılarak hazırlanmıştır."@tr ;
    kademe:surumu <https://w3id.org/kademe/id/yonetmelik/15287/m2> ;
    kademe:yururlukBaslangic "2011-09-01"^^xsd:date .

